# ==============================================================================
# ManakAI Environment Configuration
# Copy this file to .env before starting with docker-compose
# ==============================================================================

# Google Gemini API Key (Free: https://makersuite.google.com/app/apikey)
GOOGLE_API_KEY=your_gemini_api_key_here

# PostgreSQL Database Configuration
POSTGRES_DB=manakai
POSTGRES_USER=manakai_user
POSTGRES_PASSWORD=password
POSTGRES_PORT=5432

# Spring Boot Security & JWT Secret
JWT_SECRET=manakai-super-secret-jwt-key-for-sih-2026-demo-change-in-production

# CORS Allowed Origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80,http://localhost:5173,http://localhost
